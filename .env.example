# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL - Relational data (users, classes, assignments)
DATABASE_URL="postgresql://username:password@localhost:5432/thai_edu?schema=public"

# MongoDB - Document storage (learning paths, content)
MONGODB_URI="mongodb://localhost:27017/thai_edu"

# Redis - Caching and sessions
REDIS_URL="redis://localhost:6379"

# ============================================================================
# Supabase Configuration
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://kgshmvikqzykvxpofxwn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtnc2htdmlrcXp5a3Z4cG9meHduIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI3NDQ4NDksImV4cCI6MjA3ODMyMDg0OX0._McTKy_srQGoOb7yrH04m9yNdweLicqlLAUW8kGTKYE
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# AI/ML Configuration
# ============================================================================

# Google AI (Gemini) - Primary AI provider
GOOGLE_AI_API_KEY=your_google_ai_api_key

# OpenAI (Optional) - Fallback or specialized use cases
OPENAI_API_KEY=your_openai_api_key_optional

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT Secret for token signing
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# JWT Expiration
JWT_EXPIRES_IN=7d

# Session secret
SESSION_SECRET=your_session_secret_key_min_32_chars

# ============================================================================
# Application Configuration
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API URL (if different from app URL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Environment
NODE_ENV=development

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@thai-edu-platform.com

# ============================================================================
# File Storage (Optional - if not using Supabase Storage)
# ============================================================================

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=thai-edu-content

# ============================================================================
# Analytics & Monitoring (Optional)
# ============================================================================

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn

# ============================================================================
# Payment Integration (Optional - Stripe)
# ============================================================================

STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_AI_TUTOR=true
ENABLE_CONTENT_GENERATION=true
ENABLE_COLLABORATIVE_LEARNING=true
ENABLE_OFFLINE_MODE=true
ENABLE_TEACHER_NETWORK=true

# ============================================================================
# Rate Limiting
# ============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AI_MAX_REQUESTS=10

# ============================================================================
# Thai Language Support
# ============================================================================

DEFAULT_LANGUAGE=th
SUPPORTED_LANGUAGES=th,en

# ============================================================================
# Development Tools
# ============================================================================

# Enable debug logging
DEBUG=false

# Skip email verification in development
SKIP_EMAIL_VERIFICATION=true

# Seed database with test data
SEED_DATABASE=false
